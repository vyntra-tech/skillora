# ==============================================================================
# Skillora / TalentPulse - Environment Configuration Example
# Copy this file to .env and fill in the values for your local environment
# ==============================================================================

# Server Configuration
PORT=6001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRE=30d

# MongoDB Database Connection (Local or Atlas)
# Local: mongodb://127.0.0.1:27017/talent-platform
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/talent-platform
MONGODB_URI=mongodb://127.0.0.1:27017/talent-platform

# Cloudinary Configuration (Image & Asset Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Client URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

